<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:background="#0B0D10" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="TELA ESTICA" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Resolution &amp; Stretch Manager" android:textColor="#8D96A3" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Shizuku: verificando..." android:textColor="#8D96A3" android:paddingTop="18dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/gameSpinner" android:layout_width="match_parent" android:layout_height="50dp"/>
<TextView android:text="Resolución" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/width" android:hint="Ancho" android:inputType="number" android:text="1280" android:textColor="#FFFFFF" android:hintTextColor="#657080" android:layout_weight="1" android:layout_width="0dp" android:layout_height="55dp"/><TextView android:text=" × " android:textColor="#FFFFFF" android:textSize="20sp" android:gravity="center" android:layout_width="50dp" android:layout_height="55dp"/><EditText android:id="@+id/height" android:hint="Alto" android:inputType="number" android:text="720" android:textColor="#FFFFFF" android:hintTextColor="#657080" android:layout_weight="1" android:layout_width="0dp" android:layout_height="55dp"/></LinearLayout>
<Switch android:id="@+id/stretch" android:text="Pantalla estirada" android:textColor="#FFFFFF" android:checked="true" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="55dp"/>
<Button android:id="@+id/apply" android:text="APLICAR RESOLUCIÓN" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="55dp"/>
<Button android:id="@+id/restore" android:text="RESTAURAR RESOLUCIÓN" android:layout_width="match_parent" android:layout_height="55dp"/>
<TextView android:id="@+id/log" android:text="Selecciona un juego y aplica un perfil." android:textColor="#8D96A3" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>